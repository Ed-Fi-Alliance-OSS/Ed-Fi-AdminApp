# Local DMS environment settings. start-dms.ps1 copies this file to .env on first run.
# LOCAL DEVELOPMENT ONLY: every secret below is public. Never reuse these values elsewhere.

# --------------
# Host ports (bound to 127.0.0.1). Chosen to avoid the Admin App stack in compose/,
# which already uses 8080 (Keycloak), 8082, 5432, 5050 and 1433.
# --------------
DMS_PORT=8090
CONFIGURATION_SERVICE_PORT=8091
POSTGRES_PORT=5436

# --------------
# Versions
# --------------
# Tag to follow when resolving versions. The first start (and -Update) pins the exact
# images and matching schema tool version this tag points to in .dms-versions.json.
DMS_IMAGE_TAG=pre
# Optional explicit pins; when set they take precedence over .dms-versions.json.
# DMS_IMAGE=edfialliance/ed-fi-api@sha256:...
# CONFIGURATION_SERVICE_IMAGE=edfialliance/ed-fi-api-configuration-service@sha256:...
# SCHEMA_TOOLS_VERSION=8.1.0-beta.0.1.32

# --------------
# PostgreSQL (shared by DMS and the Configuration Service)
# --------------
POSTGRES_PASSWORD=abcdefgh1!
POSTGRES_DB_NAME=edfi_datamanagementservice

# --------------
# Configuration Service
# --------------
# AES key for connection strings stored by the Configuration Service; DMS receives the
# same value. At least 32 ASCII characters.
CONFIGURATION_SERVICE_DATABASE_ENCRYPTION_KEY=local-dms-database-key-0123456789abcdef
# Passphrase protecting the OpenIddict signing key in the database.
CONFIGURATION_SERVICE_IDENTITY_ENCRYPTION_KEY=local-dms-identity-key-0123456789abcdef
CONFIGURATION_SERVICE_IDENTITY_CLIENT_SECRET=ValidClientSecret1234567890!Abcd

# Admin client registered through /connect/register (scope edfi_admin_api/full_access).
# Client secrets must be 32-128 characters with upper, lower, digit and special characters.
CMS_ADMIN_CLIENT_ID=dms-local-admin
CMS_ADMIN_CLIENT_SECRET=ValidClientSecret1234567890!Abcd

# Client DMS uses to read the Configuration Service (scope edfi_admin_api/readonly_access).
DMS_CONFIGURATION_SERVICE_CLIENT_ID=CMSReadOnlyAccess
DMS_CONFIGURATION_SERVICE_CLIENT_SECRET=ValidClientSecret1234567890!Abcd

# --------------
# Logging
# --------------
LOG_LEVEL=Information
