{
  "name": "fe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/fe/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "typecheck": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": ["default", "^default"],
      "options": {
        "cwd": "packages/fe",
        "command": "tsc -p tsconfig.app.json --noEmit"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "dependsOn": ["^build", "typecheck"],
      "outputs": ["{workspaceRoot}/dist/packages/fe"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "packages/fe",
        "command": "vite build --mode production"
      },
      "configurations": {
        "development": {
          "command": "vite build --mode development --sourcemap"
        },
        "production": {
          "command": "vite build --mode production"
        }
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "packages/fe",
        "command": "vite"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "dependsOn": ["build"],
      "options": {
        "cwd": "packages/fe",
        "command": "vite preview"
      }
    }
  }
}
