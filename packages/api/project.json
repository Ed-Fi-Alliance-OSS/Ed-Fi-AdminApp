{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "packages/api/src",
  "projectType": "application",
  "tags": [],
  "targets": {
    "build-migration-config": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/migration"],
      "options": {
        "cwd": "packages/api",
        "command": "webpack-cli build --config webpack.migration.config.js",
        "env": {
          "NODE_ENV": "production"
        }
      }
    },
    "migrations:generate": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["build-migration-config"],
      "options": {
        "cwd": "packages/api",
        "commands": [
          "typeorm -d ../../dist/packages/migration/main.js migration:generate src/database/migrations/pgsql/{args.name}"
        ]
      }
    },
    "schema:drop": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["build-migration-config"],
      "options": {
        "cwd": "packages/api",
        "commands": ["typeorm -d ../../dist/packages/migration/main.js schema:drop"]
      }
    },
    "migrations:revert": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["build-migration-config"],
      "options": {
        "cwd": "packages/api",
        "commands": ["typeorm -d ../../dist/packages/migration/main.js migration:revert"]
      }
    },
    "migrations:run": {
      "executor": "nx:run-commands",
      "outputs": ["{options.outputPath}"],
      "dependsOn": ["build-migration-config"],
      "options": {
        "cwd": "packages/api",
        "commands": ["typeorm -d ../../dist/packages/migration/main.js migration:run"]
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist/packages/api"],
      "defaultConfiguration": "production",
      "options": {
        "cwd": "packages/api",
        "command": "webpack-cli build --config webpack.config.js"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        },
        "production": {
          "env": {
            "NODE_ENV": "production"
          }
        }
      }
    },
    "serve": {
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "api:build"
      },
      "configurations": {
        "development": {
          "buildTarget": "api:build:development"
        },
        "production": {
          "buildTarget": "api:build:production"
        }
      }
    },
    "serve-watch": {
      "executor": "nx:run-commands",
      "continuous": true,
      "dependsOn": ["^build"],
      "defaultConfiguration": "development",
      "options": {
        "command": "webpack-cli build --config packages/api/webpack.config.js --watch --env serve"
      },
      "configurations": {
        "development": {
          "env": {
            "NODE_ENV": "development"
          }
        }
      }
    },
    "test": {
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    }
  }
}
