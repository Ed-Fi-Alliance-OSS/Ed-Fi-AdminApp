meta {
  name: certification/run with a missing input - rejected (400)
  type: http
  seq: 7
  tags: Certification
}

post {
  url: {{BASE_URL}}/teams/{{process.env.CERT_TEAM_ID}}/edfi-tenants/{{process.env.CERT_EDFI_TENANT_ID}}/certification/runs/{{certRunId}}/steps/{{process.env.CERT_STEP_01_ID}}/run
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{ACCESS_TOKEN}}
}

body:json {
  {}
}

script:pre-request {
  if (!bru.getProcessEnv('CERT_TEAM_ID')) {
    bru.runner.skipRequest();
    return;
  }
  const odsId = bru.getProcessEnv('CERT_ODS_ID');
  req.setBody({ ...(odsId ? { odsId: Number(odsId) } : {}), token: bru.getVar('certToken') || 'x', inputs: {} });
}

tests {
  test("certification/run with a missing input - status is 400", function() {
    expect(res.getStatus()).to.equal(400);
  });
}
